class Solution {
public:
    vector<int> separateDigits(vector<int>& nums) {
        
        int n = nums.size();
        vector<int> ans;

        for (int i =0; i<n; i++) {

            vector<int> temp;
            while (nums[i] != 0) {

                int n = nums[i] % 10;
                temp.push_back(n);
                nums[i] = nums[i] / 10;
            }

            reverse(temp.begin(), temp.end());
            ans.insert(ans.end(), temp.begin(), temp.end());
        }
        return ans;
    }
};